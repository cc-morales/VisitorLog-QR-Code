@page "/registration"
@using VisitorLog.Models
@using VisitorLog.Services.VisitorManagementService
@using VisitorLog.Services.QRSetManagementService
@using VisitorLog.Services.Auth
@inject IVisitorManagementService _visitorService
@inject IQRSetManagementService _qrSetService
@inject IDialogService _dialogService
@inject ISnackbar _snackbar
@inject SimpleAuthStateProvider _authProvider

<CascadingAuthenticationState>
    <MudContainer MaxWidth="MaxWidth.False" Style="margin-top: 60px;">
        <AuthorizeView>
            <Authorized>
                <MudPaper>
                    <MudStack Class="pa-1 header-table" Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">Visitor Registration</MudText>
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField Placeholder="Search" 
                                          @bind-Value="search" 
                                          Adornment="Adornment.Start" 
                                          AdornmentIcon="@Icons.Material.Filled.Search" 
                                          Immediate="true"
                                          OnImmediateValueChanged="OnSearchChanged" />
                            <MudSpacer/>
                            <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                           Color="Color.Primary" 
                                           OnClick="AddVisitor" />
                        </MudStack>
                    </MudStack>

                    <MudTable Context="visitor" Items="Filtered" Hover="true" Class="mt-4">
                        <HeaderContent>
                            <MudTh>Picture</MudTh>
                            <MudTh>Name</MudTh>
                            <MudTh>Contact Number</MudTh>
                            <MudTh>Purpose</MudTh>
                            <MudTh>QR Code</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Picture">
                                @if (visitor.Picture?.Length > 0)
                                {
                                        <MudAvatar
                                               Size="Size.Large" >
                                        <MudImage Src="@($"data:image/png;base64,{Convert.ToBase64String(visitor.Picture)}")"
                                                  Alt="@visitor.Name"
                                                  Width="50"
                                                  Height="50"
                                                  ObjectFit="ObjectFit.Cover"
                                                  Class="rounded" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Color="Color.Primary" Size="Size.Medium">@visitor.Name.FirstOrDefault()</MudAvatar>
                                }
                            </MudTd>
                            <MudTd DataLabel="Name">@visitor.Name</MudTd>
                            <MudTd DataLabel="Contact">@visitor.ContactNumber</MudTd>
                            <MudTd DataLabel="Purpose">@visitor.PurposeOfVisit</MudTd>
                            <MudTd DataLabel="QR Code">
                                @if (qrSetCache.TryGetValue(visitor.VisitorId, out var qrSet) && qrSet?.QRCode != null)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@qrSet.QRCode.QRCodeAlias</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Not Set</MudChip>
                                }
                            </MudTd>
                            <MudTd Class="text-end">
                                @if (qrSetCache.TryGetValue(visitor.VisitorId, out var existingSet) && existingSet != null)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.QrCode" 
                                                   Color="Color.Warning" 
                                                   Size="Size.Medium" 
                                                   OnClick="@(() => RemoveQRCode(visitor))" 
                                                   Title="Remove QR Code" />
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.QrCode" 
                                                   Color="Color.Primary" 
                                                   Size="Size.Medium" 
                                                   OnClick="@(() => SetQRCode(visitor))" 
                                                   Title="Set QR Code" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                               Color="Color.Primary" 
                                               Size="Size.Medium" 
                                               OnClick="@(() => EditVisitor(visitor))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Color="Color.Error" 
                                               Size="Size.Medium"
                                               OnClick="@(() => DeleteVisitor(visitor))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </Authorized>
            <NotAuthorized>
                <MudPaper Class="pa-6 d-flex flex-column align-center">
                    <MudText Typo="Typo.h6">You are not authorized</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">Please authorize to register visitors.</MudText>
                    <MudButton Color="Color.Primary" OnClick="OpenAuthorize">Authorize</MudButton>
                </MudPaper>
            </NotAuthorized>
        </AuthorizeView>
    </MudContainer>
</CascadingAuthenticationState>

@code {
    private List<VisitorModel> items = new();
    private Dictionary<Guid, QRSetModel?> qrSetCache = new();
    private string search = string.Empty;

    private IEnumerable<VisitorModel> Filtered => string.IsNullOrWhiteSpace(search)
        ? items
        : items.Where(x => (x.Name ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)
                        || (x.ContactNumber ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)
                        || (x.PurposeOfVisit ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        items = await _visitorService.GetVisitorsAsync();
        
        qrSetCache.Clear();
        foreach (var visitor in items)
        {
            var qrSet = await _qrSetService.GetQRSetByVisitorIdAsync(visitor.VisitorId);
            qrSetCache[visitor.VisitorId] = qrSet;
        }
        
        StateHasChanged();
    }

    private void OnSearchChanged(string _) => StateHasChanged();

    private async Task SetQRCode(VisitorModel visitor)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await _dialogService.ShowAsync<QRCodeSelectDialog>("Select QR Code", options);
        var result = await dialog.Result;

        if (!result?.Canceled is true && result?.Data is QRCodeModel qr)
        {
            var qrSet = new QRSetModel
            {
                VisitorId = visitor.VisitorId,
                QRCodeId = qr.QRCodeId
            };

            var success = await _qrSetService.AddQRSetAsync(qrSet);
            
            if (success)
            {
                await LoadAsync();
                _snackbar.Add($"QR Code '{qr.QRCodeAlias}' assigned to {visitor.Name}", Severity.Success);
            }
            else
            {
                _snackbar.Add($"QR Code '{qr.QRCodeAlias}' is already assigned to another visitor.", Severity.Error);
            }
        }
    }

    private async Task RemoveQRCode(VisitorModel visitor)
    {
        await _qrSetService.DeleteQRSetByVisitorIdAsync(visitor.VisitorId);
        await LoadAsync();
        _snackbar.Add($"QR Code removed from {visitor.Name}", Severity.Info);
    }

    private async Task AddVisitor()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await _dialogService.ShowAsync<VisitorDialog>("Register Visitor", options);
        var result = await dialog.Result;

        if (!result?.Canceled is true && result?.Data is VisitorModel visitor)
        {
            await _visitorService.AddVisitorAsync(visitor);
            await LoadAsync();
            _snackbar.Add("Visitor registered.", Severity.Success);
        }
    }

    private async Task EditVisitor(VisitorModel v)
    {
        var parameters = new DialogParameters { ["Visitor"] = v };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await _dialogService.ShowAsync<VisitorDialog>("Edit Visitor", parameters, options);
        var result = await dialog.Result;

        if (!result?.Canceled is true && result?.Data is VisitorModel updated)
        {
            await _visitorService.UpdateVisitorAsync(updated);
            await LoadAsync();
            _snackbar.Add("Visitor updated.", Severity.Success);
        }
    }

    private async Task DeleteVisitor(VisitorModel v)
    {
        bool? accept = await ConfirmDelete();
        if (accept is true)
        {
            await _qrSetService.DeleteQRSetByVisitorIdAsync(v.VisitorId);
            await _visitorService.DeleteVisitorAsync(v.VisitorId);
            await LoadAsync();
            _snackbar.Add("Visitor deleted.", Severity.Info);
        }
    }

    private async Task<bool?> ConfirmDelete()
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = "Are you sure you want to delete this visitor?",
            ["ButtonText"] = "Delete"
        };
        var options = new DialogOptions { CloseButton = true };
        var dialog = await _dialogService.ShowAsync<ConfirmDialog>("Confirm", parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled is true) return false;
        return result?.Data is bool b && b;
    }

    private async Task OpenAuthorize()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
        var dialog = await _dialogService.ShowAsync<AuthorizedDialog>("Authorize", options);
        var result = await dialog.Result;

        if (!result?.Canceled is true && result?.Data is bool ok && ok)
        {
            await _authProvider.SignInAsync("admin");
            _snackbar.Add("Authorized. You are signed in.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            _snackbar.Add("Authorization failed or cancelled.", Severity.Warning);
        }
    }
}
