@page "/"

@inject IJSRuntime JS
@using ReactorBlazorQRCodeScanner
@using VisitorLog.Models


<PageTitle>Scanner</PageTitle>

@if (!_found)
{
        <MudStack AlignItems="AlignItems.Center" Class="px-2" Spacing="2" Style="margin-top: 50px;">
            <MudText Typo="Typo.button">SCAN QR CODE</MudText>
            <QRCodeScanner LoadingMessage="Scanning..."/>
            <Logs @ref="logsRef"/>
        </MudStack>
   
} else
{
    <Visitor VisitorModel="_currentVisitor" OnAdd="Refresh"/> 
}

@code {

    private QRCodeScannerJsInterop? _qrCodeScannerJsInterop;
    private Action<string>? _onQrCodeScanAction;

    private static bool _found;
    private VisitorModel? _currentVisitor = new();
    private Logs? logsRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _onQrCodeScanAction = async (code) => await OnQrCodeScan(code);

            _qrCodeScannerJsInterop = new QRCodeScannerJsInterop(JS);

            await _qrCodeScannerJsInterop.Init(_onQrCodeScanAction);
        }
    }

    private async Task Refresh()
    {
        await logsRef!.LoadAsync();

        _navigationManager.NavigateTo("/", true);

        _found = false;

        await InvokeAsync(StateHasChanged);

    }

    private async Task OnQrCodeScan(string code)
    {
        Console.WriteLine($"QR CODE - {code}");

        _currentVisitor = await _qrCodeService.GetVisitor(code);

        if (_currentVisitor is null) return;

        _found = true;

        await InvokeAsync(StateHasChanged);
    }
}