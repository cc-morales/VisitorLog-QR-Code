@page "/"
@using VisitorLog.Services.Auth
@inject IDialogService _dialogService
@inject SimpleAuthStateProvider _authProvider
@inject ISnackbar _snackbar
@inject NavigationManager _navigationManager
    
<MudGrid Class="mb-4" Style="margin-top: 80px;" Spacing="0">
    <MudItem xs="12" lg="3"></MudItem>
    <MudItem xs="12" md="4" lg="6">
        <MudPaper Elevation="1" Class="pa-1">
            <MudImage Class="custom-image" Src="css/images/bg.png"></MudImage>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="3"></MudItem>
</MudGrid>
<MudStack AlignItems="AlignItems.Center">
    <MudButton Class="custom-button-2" OnClick="OpenAccountSignIn">ACCOUNT SIGN IN/LOG IN</MudButton>
    <MudButton Class="custom-button-2" OnClick="NavigateToQRCodes">GENERATE NEW QR PASS</MudButton>
    <MudButton Class="custom-button-2" OnClick="OpenAboutVisits">ABOUT V.I.S.I.T.S</MudButton>
</MudStack>

@code {
    private async Task OpenAccountSignIn()
    {
        var options = new DialogOptions 
        { 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true, 
            BackdropClick = true,
            CloseButton = false
        };
        
        var dialog = await _dialogService.ShowAsync<LoginDialog>("Account Sign In", options);
        var result = await dialog.Result;

        if (!result?.Canceled is true)
        {
            _snackbar.Add("Login successful!", Severity.Success);
            _navigationManager.NavigateTo("/qrcodes");
        }
    }

    private void NavigateToQRCodes()
    {
        _navigationManager.NavigateTo("/qrcodes");
    }

    private async Task OpenAboutVisits()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await _dialogService.ShowAsync<AboutVisitsDialog>("About V.I.S.I.T.S", options);
    }
}