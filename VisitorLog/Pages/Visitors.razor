@page "/visitors"
@using VisitorLog.Models

@inject IDialogService _dialogService
@inject SimpleAuthStateProvider _authProvider
@inject ISnackbar _snackbar

@attribute [Authorize]
<CascadingAuthenticationState>
<MudContainer MaxWidth="MaxWidth.False" Style="margin-top: 60px;">
    <AuthorizeView>
        <Authorized>
            <MudPaper Class="pa-4">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h6">Visitors</MudText>
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudTextField Placeholder="Search" @bind-Value="search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" OnImmediateValueChanged="OnSearchChanged" />
                        <MudSpacer/>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddVisitor" />
                    </MudStack>
                </MudStack>

                <MudTable Context="visitor" Items="Filtered" Hover="true" Class="mt-4">
                    <ColGroup>
                        <col/>
                        <col/>
                        <col style="width: 10%;"/>
                    </ColGroup>
                    <HeaderContent>
                        <MudTh>QR Code</MudTh>
                        <MudTh>Visitor Alias</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="QR Code">@visitor.QRCode</MudTd>
                        <MudTd DataLabel="Visitor Alias">@visitor.VisitorAlias</MudTd>
                        <MudTd Class="text-center">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditVisitor(visitor))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteVisitor(visitor))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </Authorized>
        <NotAuthorized>
            <MudPaper Class="pa-6 d-flex flex-column align-center">
                <MudText Typo="Typo.h6">You are not authorized</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">Please authorize to manage visitors.</MudText>
                <MudButton Color="Color.Primary" OnClick="OpenAuthorize">Authorize</MudButton>
            </MudPaper>
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>
</CascadingAuthenticationState>
@code {
    private List<VisitorModel> items = new();
    private string search = string.Empty;

    private IEnumerable<VisitorModel> Filtered => string.IsNullOrWhiteSpace(search)
        ? items
        : items.Where(x => (x.QRCode ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)
                                || (x.VisitorAlias ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        // var dict = await _qrCodeService.GetVisitorsAsync();

        // dict ??= [];

        // items = dict.Values.ToList();

        StateHasChanged();
    }

    private void OnSearchChanged(string _)
    {
        StateHasChanged();
    }

    private async Task AddVisitor()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await _dialogService.ShowAsync<VisitorDialog>("Add Visitor", options);
        var result = await dialog.Result;

        if (!result?.Canceled is true && result?.Data is (VisitorModel vm, string old))
        {
            // await _qrCodeService.AddVisitorAsync(vm);
            await LoadAsync();
            _snackbar.Add("Visitor added.", Severity.Success);
        }
    }

    private async Task EditVisitor(VisitorModel v)
    {
        var parameters = new DialogParameters { ["Visitor"] = v };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await _dialogService.ShowAsync<VisitorDialog>("Edit Visitor", parameters, options);
        var result = await dialog.Result;

        if (!result?.Canceled is true && result?.Data is (VisitorModel vm, string oldQR))
        {
            // await _qrCodeService.UpdateVisitorAsync(vm, oldQR);
            await LoadAsync();
            _snackbar.Add("Visitor updated.", Severity.Success);
        }
    }

    private async Task DeleteVisitor(VisitorModel v)
    {
        bool? accept = await ConfirmDelete();
        if (accept is true)
        {
            // await _qrCodeService.DeleteVisitorAsync(v);
            await LoadAsync();
            _snackbar.Add("Visitor deleted.", Severity.Info);
        }
    }

    private async Task<bool?> ConfirmDelete()
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = "Are you sure you want to delete this visitor?",
            ["ButtonText"] = "Delete"
        };
        var options = new DialogOptions { CloseButton = true };
        var dialog = await _dialogService.ShowAsync<ConfirmDialog>("Confirm", parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled is true) return false;
        return result?.Data is bool b && b;
    }

    private async Task OpenAuthorize()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = true };
        var dialog = await _dialogService.ShowAsync<AuthorizedDialog>("Authorize", options);
        var result = await dialog.Result;

        if (!result?.Canceled is true && result?.Data is bool ok && ok)
        {
            await _authProvider.SignInAsync("admin");

            _snackbar.Add("Authorized. You are signed in.", Severity.Success);

            await LoadAsync();
        }
        else
        {
            _snackbar.Add("Authorization failed or cancelled.", Severity.Warning);
        }
    }
}