@using VisitorLog.Models

<MudItem xs="12" Style="width: 85%;">
    <MudPaper Class="flex-grow-1 mb-3 overflow-auto">
        @if (entries?.Any() is true)
        {
            @foreach (var entry in entries)
            {
                <MudStack Class="pa-2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Row Style="width:100%">
                    <MudText Typo="Typo.subtitle2">@entry.VisitorsName</MudText>
                    <MudText Class="text-center" Typo="Typo.caption">@entry.Visitor.VisitorAlias</MudText>
                    <MudText Class="text-end" Typo="Typo.caption">@entry.DateCreated.Humanize()</MudText>
                </MudStack>
                <MudDivider />
            }
        }
        else
        {
            <MudStack Class="pa-4" Justify="Justify.Center" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2">No logs yet.</MudText>
            </MudStack>
        }
    </MudPaper>

</MudItem>
    @code {
    private List<LogModel> entries = new();


    public async Task LoadAsync()
    {
        entries = await _visitorLogService.GetVisitorLogsAsync();

        entries.OrderDescending();

        entries ??= [];

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadAsync();
    }
}