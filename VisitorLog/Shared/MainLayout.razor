@inherits LayoutComponentBase

@inject IDialogService _dialogService
@inject SimpleAuthStateProvider _authProvider
@inject ISnackbar _snackbar
@inject NavigationManager _navigationManager

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<PageTitle>VisitorLog</PageTitle>

<MudLayout Class="main-content-bg">
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6">@GetPageTitle()</MudText>
        <MudSpacer />
    </MudAppBar>
    <MudDrawer @bind-Open="@_open" Breakpoint="@_breakpoint" Elevation="1" Variant="@DrawerVariant.Responsive" Color="Color.Inherit">
        <MudDrawerHeader Class="d-felx justify-content-center align-items-center">
            <MudText  Typo="Typo.h6">V.I.S.I.T.S</MudText>
        </MudDrawerHeader>
        <MudNavMenu Class="d-flex flex-column gap-1 py-2">
            <MudNavLink Class="custom-button" Href="/" Icon="@Icons.Material.Filled.Home" IconColor="Color.Error" Match="NavLinkMatch.All">HOME</MudNavLink>
            <MudNavLink Class="custom-button" Href="/qrcodes" Icon="@Icons.Material.Filled.QrCode" IconColor="Color.Error" Match="NavLinkMatch.All">QR CODES</MudNavLink>
            <MudNavLink Class="custom-button" Href="/registration" Icon="@Icons.Material.Filled.PersonAdd" IconColor="Color.Error" Match="NavLinkMatch.All">REGISTRATION</MudNavLink>
            <MudNavLink Class="custom-button" Href="/scan" Icon="@Icons.Material.Filled.QrCodeScanner" IconColor="Color.Error" Match="NavLinkMatch.All">SCAN</MudNavLink>
            <MudNavLink Class="custom-button" Href="/timestamp" Icon="@Icons.Material.Filled.FormatListBulleted" IconColor="Color.Error" Match="NavLinkMatch.All">TIME STAMP</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pa-2">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _open = false;
    private Breakpoint _breakpoint = Breakpoint.Lg;

    protected override void OnInitialized()
    {
        _navigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private void ToggleDrawer()
    {
        _open = !_open;
    }

    private string GetPageTitle()
    {
        var path = new Uri(_navigationManager.Uri).AbsolutePath.ToLower();

        return path switch
        {
            "/" => "HOME PAGE",
            "/qrcodes" => "QR CODES",
            "/registration" => "REGISTRATION",
            "/scan" => "QR PASS SCANNING (TIMEIN/TIMEOUT)",
            "/timestamp" => "TIME STAMP",
            _ => "V.I.S.I.T.S"
        };
    }

    private async Task RegisterQrClicked()
    {
        var authorized = await ShowAuthorizeDialogAsync();

        if (authorized)
        {
            await _authProvider.SignInAsync("admin");

            _navigationManager.NavigateTo("/visitors");

            _snackbar.Add("Authorized. You are signed in.", Severity.Success);
        }
        else
        {
            _snackbar.Add("Authorization failed or cancelled.", Severity.Warning);
        }
    }

    private async Task<bool> ShowAuthorizeDialogAsync()
    {
        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var dialog = await _dialogService.ShowAsync<AuthorizedDialog>("Authorize", options);
        var result = await dialog.Result;

        if (result?.Canceled is true) return false;

        return result?.Data is bool b && b;
    }

    public void Dispose()
    {
        _navigationManager.LocationChanged -= OnLocationChanged;
    }
}
