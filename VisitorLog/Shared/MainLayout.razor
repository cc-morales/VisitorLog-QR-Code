@inherits LayoutComponentBase

@inject IDialogService _dialogService
@inject SimpleAuthStateProvider _authProvider
@inject ISnackbar _snackbar

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<PageTitle>VisitorLog</PageTitle>

<div class="page">
    <MudAppBar style="width: 100%;">
        <MudItem xs="12">
            <MudStack Class="header-links" AlignItems="AlignItems.Center" Justify="Justify.SpaceEvenly" Row StretchItems="StretchItems.None">
                <MudNavLink Class="custom-button" Href="/" Match="NavLinkMatch.All">HOME</MudNavLink>
                <MudNavLink Class="custom-button" Href="/regsitration" Match="NavLinkMatch.All">REGISTRATION</MudNavLink>
                <MudNavLink Class="custom-button" Href="/scan" Match="NavLinkMatch.All">SCAN</MudNavLink>
                <MudNavLink Class="custom-button" Href="/timestamp" Match="NavLinkMatch.All">LOGS</MudNavLink>
            </MudStack>
        </MudItem>
        @* <MudText Typo="Typo.h6">Visitor Log</MudText>
        <MudSpacer/> *@
        @* <MudButton StartIcon="@Icons.Material.Filled.QrCode" Color="Color.Warning" OnClick="">Register QR</MudButton> *@
    </MudAppBar>
    <main>
        
        <article class="container d-flex justify-content-center content px-4 overflow-hidden" style="height: 100vh;">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task RegisterQrClicked()
    {
        var authorized = await ShowAuthorizeDialogAsync();

        if (authorized)
        {
            await _authProvider.SignInAsync("admin");

            _navigationManager.NavigateTo("/visitors");

            _snackbar.Add("Authorized. You are signed in.", Severity.Success);
        }
        else
        {
            _snackbar.Add("Authorization failed or cancelled.", Severity.Warning);
        }
    }

    private async Task<bool> ShowAuthorizeDialogAsync()
    {
        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            BackdropClick = false
        };

        var dialog = await _dialogService.ShowAsync<AuthorizedDialog>("Authorize", options);
        var result = await dialog.Result;

        if (result?.Canceled is true) return false;

        return result?.Data is bool b && b;
    }
}
