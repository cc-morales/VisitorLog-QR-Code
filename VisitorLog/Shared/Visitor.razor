@using VisitorLog.Models

<MudItem xs="12" md="8" lg="5" Style="margin: 60px;">
    <MudPaper Class="pa-2 d-flex align-items-center justify-content-center">
        <MudStack Class="px-4" Style="width: 100%;">
            <h3>Visitor</h3>
            <MudTextField @bind-Value="LogModel.VisitorsName" Typo="Typo.button"Variant="Variant.Outlined" Label="Please type your name..."></MudTextField>
		    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Submit</MudButton>
        </MudStack>
    </MudPaper>
</MudItem>
@code {
    [Parameter, EditorRequired] public VisitorModel? VisitorModel { get; set; }

    [Parameter] public EventCallback OnAdd { get; set; }

    private LogModel LogModel { get; set; } = new();

    private async Task Submit()
    {

        LogModel.Visitor = VisitorModel!;

        // await _visitorLogService.AddVisitorLogAsync(LogModel);

        await OnAdd.InvokeAsync();
    }
}
